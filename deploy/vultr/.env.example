# Copy to /opt/jweller/deploy/.env on the VPS — never commit real secrets.
# Prefer Atlas: set MONGO_URL to mongodb+srv://...

MONGO_URL=mongodb+srv://USER:PASS@cluster.mongodb.net/?appName=Cluster0
REGISTRY_DB=platform_registry
JWT_SECRET=change-me-generate-a-long-random-string
APP_ENV=development
OTP_DEV_CODE=123456

# Razorpay Test Mode (0 = real sandbox)
MOCK_RAZORPAY=0
ALLOW_PAY_DEV_CONFIRM=0
DEMO_RAZORPAY_KEY_ID=rzp_test_...
DEMO_RAZORPAY_KEY_SECRET=
DEMO_RAZORPAY_WEBHOOK_SECRET=

# Cloudflare R2 — or set MOCK_R2=1 for local/demo without R2
# MOCK_R2=1
BUCKET_ENDPOINT=https://ACCOUNT.r2.cloudflarestorage.com
BUCKET_NAME=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
BUCKET_REGION=auto
# BUCKET_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev

PLATFORM_ADMIN_EMAIL=ops@luxejewel.app
PLATFORM_ADMIN_PASSWORD=Platform@123
