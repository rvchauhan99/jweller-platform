# Cloudflare R2 (S3-compatible) — product gallery images
# Same env names as QuickerPay. Never commit real secrets.
#
# BUCKET_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# BUCKET_NAME=jewelers-assets
# BUCKET_ACCESS_KEY_ID=
# BUCKET_SECRET_ACCESS_KEY=
# BUCKET_REGION=auto
# Public CDN / r2.dev hostname for storefront <img src> (no trailing slash):
# BUCKET_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
#
# Local / pytest without Cloudflare:
MOCK_R2=1

# PLATFORM_ADMIN_EMAIL=ops@luxejewel.app
# PLATFORM_ADMIN_PASSWORD=Platform@123

# Razorpay Test Mode (local demo / hardening — never commit real secrets)
# MOCK_RAZORPAY=0
# ALLOW_PAY_DEV_CONFIRM=0
# DEMO_RAZORPAY_KEY_ID=rzp_test_...
# DEMO_RAZORPAY_KEY_SECRET=...
# DEMO_RAZORPAY_WEBHOOK_SECRET=...   # enables signed webhook smoke + Dashboard match
